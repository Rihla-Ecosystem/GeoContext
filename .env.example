# ==========================================
# GeoContext - Environment Variables Template
# ==========================================

# ------------------------------------------
# Required Variables
# ------------------------------------------

# Database connection string (Must use postgresql+asyncpg driver)
# For docker-compose, use: postgresql+asyncpg://postgres:postgres@db:5432/geocontext
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/geocontext"

# Shared secret for verifying Supabase JWTs (HS256)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Temporary secret for admin panel bypass
ADMIN_BOOTSTRAP_SECRET="local-dev-bootstrap-secret"

# ------------------------------------------
# Optional / Overridable Defaults
# ------------------------------------------

# Determines logging format (local = colors, production = JSON)
# ENVIRONMENT="local"

# Algorithm for verifying JWTs (Supabase uses HS256)
# (removed old RS256 algorithm override)

# JSON list of allowed CORS origins
# BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# Global rate limit settings for the slowapi rate limiter
# RATE_LIMIT_GLOBAL="100/minute"

# Default radius in meters to use for geofencing spatial queries
# DEFAULT_DETECTION_RADIUS=50.0
